const searchModel = require('../models/searchModel')

async function getAllListings(req, res) {
  try {
    console.log('GET /api/search hit')

    const listings = await searchModel.getAllListings()

    console.log('rows returned:', listings.length)

    res.json({
      items: listings,
      total: listings.length
    })
  } catch (err) {
    console.error('Error fetching listings:', err)
    res.status(500).json({
      error: err.message
    })
  }
}

module.exports = {
  getAllListings
}