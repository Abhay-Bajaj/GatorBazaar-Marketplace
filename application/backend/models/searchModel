const pool = require('../database')

async function getListings({ keyword = '', category = '', sort = '' }) {
    let sql = 
    `SELECT 
          l.listing_id,
          l.title,
          l.description,
        l.price,
        c.category_name,
        MIN(li.image_url) AS image_url
    FROM listings l
    JOIN Categories c ON l.category = c.category_id
    LEFT JOIN listing_images li ON l.listing_id = li.listing_id
    WHERE l.active = 1
    GROUP BY l.listing_id`
    

    const params = []


    if (keyword) {
        sql += ' AND (l.title LIKE ? OR l.description LIKE ?)'
        params.push(`%${keyword}%`, `%${keyword}%`)
    }

    if (category) {
        sql += ' AND LOWER(c.category_name) = LOWER(?)'
        params.push(category.trim())
    }

    if (sort === 'price_low') {
        sql += ' ORDER BY l.price ASC'
    } else if (sort === 'price_high') {
        sql += ' ORDER BY l.price DESC'
    } else if (sort === 'newest') {
        sql += ' ORDER BY l.created_at DESC'
    }

    const [rows] = await pool.query(sql, params)
    return rows
}

module.exports = {
    getListings,
}